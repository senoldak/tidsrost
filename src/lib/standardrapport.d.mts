export type Regel = { navn: string; antall: number };
export type Seksjon = {
  ceyrek: string;
  navn: string;
  periode: string;
  bot: number;
  eier: number;
  kjede: number;
  rettelser: number;
  fjernet: number;
  klager: { totalt: number; yerinde: number; kismen: number; yerindeDegil: number };
  yazildi: number;
  elendi: number;
  kirmizi: number;
  sari: number;
  ovrige: number;
  sariRegler: Regel[];
  kirmiziRegler: Regel[];
  geminiCagri: number;
  regelEndringer: string[] | null;
  loggFra: string | null;
};
export function osloDag(t: string | number | Date): string;
export function datoTekst(dag: string): string;
export function kvartalNavn(ceyrek: string): string;
export function periodeTekst(bas: string, son: string): string;
export const REGELNAVN: Record<string, string>;
export function regelnavn(kode: string): string;
export function regelListe(kurallar?: Record<string, number> | null): Regel[];
export function innholdTall(innhold: any, bas: string, son: string): Omit<Seksjon, 'ceyrek' | 'navn' | 'periode' | 'yazildi' | 'elendi' | 'kirmizi' | 'sari' | 'ovrige' | 'sariRegler' | 'kirmiziRegler' | 'geminiCagri' | 'regelEndringer' | 'loggFra'>;
export function ovrigeForkastede(r: { elendi?: number; kirmizi?: number }): number;
export function sorterRapporter<T extends { bas: string }>(liste: T[]): T[];
export function kvartalSeksjon(rapport: any, innhold: any): Seksjon;
