---
// Ukesbrev påmelding. Sendes til Worker-uç noktası /api/bulten/abone (bkz. worker/bulten.mjs).
// Tuzak alanı ("web") görünmez ve klavyeyle erişilemez; doluysa Worker sessizce yok sayar.
interface Props {
  id?: string;
}
const { id = 'bulten-skjema' } = Astro.props;
---

<section class="bulten-skjema" aria-labelledby={`${id}-tittel`}>
  <h2 id={`${id}-tittel`}>Ukesbrev på e-post</h2>
  <p>Én e-post hver mandag med ukens viktigste saker. Adressen brukes bare til ukesbrevet.</p>
  <form action="/api/bulten/abone" method="post" class="bulten-form">
    <div class="bulten-felt">
      <label for={`${id}-epost`}>E-postadresse</label>
      <input
        id={`${id}-epost`}
        name="eposta"
        type="email"
        required
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        placeholder="navn@eksempel.no"
      />
    </div>
    <div class="bulten-web" aria-hidden="true">
      <label for={`${id}-web`}>La denne stå tom</label>
      <input id={`${id}-web`} name="web" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button type="submit">Meld meg på</button>
  </form>
  <p class="bulten-note">
    Vi sender en bekreftelseslenke først. Du kan melde deg av når som helst. Les hvordan vi behandler adressen din på
    <a href="/personvern/#ukesbrev">personvernsiden</a>.
  </p>
</section>
