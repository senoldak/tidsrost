---
// Navnesøk: fornavn og etternavn fra /navn/sok.json (hentes første gang feltet får fokus). Treff vises som liste;
// navn med egen side er lenker. Resultatene lages med textContent (ingen innerHTML). CSP-vennlig: pakket script, ingen stil-attributt.
---

<div class="datasok navnesok" data-kilde="/navn/sok.json">
  <label for="navnesok-felt" class="datasok-label navnesok-label">Søk etter et fornavn eller etternavn</label>
  <input id="navnesok-felt" class="datasok-felt navnesok-felt" type="search" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="For eksempel Ola eller Hansen" />
  <p class="datasok-status navnesok-status data-merknad" role="status" aria-live="polite"></p>
  <ul class="datasok-liste navnesok-liste"></ul>
</div>

<script>
  type Post = { n: string; k: 'J' | 'G' | 'E'; a: number | null; s?: string };
  const rot = document.querySelector<HTMLElement>('.navnesok');
  if (rot) {
    const felt = rot.querySelector<HTMLInputElement>('.navnesok-felt')!;
    const liste = rot.querySelector<HTMLUListElement>('.navnesok-liste')!;
    const status = rot.querySelector<HTMLElement>('.navnesok-status')!;
    const TYPE = { J: 'jentenavn', G: 'guttenavn', E: 'etternavn' };
    let poster: Post[] | null = null;
    let laster: Promise<void> | null = null;

    const normaliser = (t: string) => t.trim().toLocaleLowerCase('nb');

    async function last() {
      if (poster) return;
      laster ??= fetch(rot!.dataset.kilde!)
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((j: Post[]) => {
          poster = j;
        })
        .catch(() => {
          laster = null;
          status.textContent = 'Kunne ikke laste navnelisten. Prøv igjen senere.';
        });
      await laster;
    }

    function vis() {
      liste.replaceChildren();
      const q = normaliser(felt.value);
      if (!q || !poster) {
        if (!q) status.textContent = '';
        return;
      }
      const treff = poster
        .map((p) => {
          const n = normaliser(p.n);
          return { p, rang: n === q ? 0 : n.startsWith(q) ? 1 : n.includes(q) ? 2 : 3 };
        })
        .filter((x) => x.rang < 3)
        .sort((x, y) => x.rang - y.rang || (y.p.a ?? -1) - (x.p.a ?? -1) || x.p.n.localeCompare(y.p.n, 'nb'))
        .slice(0, 12);
      if (!treff.length) {
        status.textContent = 'Ingen treff. SSB oppgir bare navn som mange har.';
        return;
      }
      status.textContent = treff.length === 12 ? 'Viser de første treffene.' : `${treff.length} treff`;
      for (const { p } of treff) {
        const li = document.createElement('li');
        const navn = document.createElement(p.s ? 'a' : 'span');
        navn.textContent = p.n;
        navn.className = 'datasok-navn';
        if (p.s) (navn as HTMLAnchorElement).href = `/navn/${p.s}/`;
        const info = document.createElement('span');
        info.className = 'datasok-info';
        info.textContent = `${TYPE[p.k]} · ${p.a === null ? 'antall ikke oppgitt' : `${p.a.toLocaleString('nb-NO')} personer`}`;
        li.append(navn, info);
        liste.append(li);
      }
    }

    felt.addEventListener('focus', () => void last());
    felt.addEventListener('input', async () => {
      await last();
      vis();
    });
    rot.closest('form')?.addEventListener('submit', (e) => e.preventDefault());
  }
</script>
