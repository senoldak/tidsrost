---
// Haberin işaret satırı: farevarsel, Siste nytt, tür (Forklart / Analyse), kategori, yazar, saat, kaynak.
// Üretim işareti ve lesetid listelerden çıkarıldı (30.10.2026): üretim notu haber sayfasında durur.
import Symbol from './Symbol.astro';
import { SITE, categoryName, formatDay, formatTime, varsel } from '../lib/site';
import { ANALYSE, erAnalyse, erForklart, FORKLART, forfatterSlug, kilde, type Haber } from '../lib/news';
import { synligForfatter } from '../lib/forfatter.mjs';

interface Props {
  haber: Haber;
  showCategory?: boolean;
  time?: 'full' | 'short' | false;
}

const { haber, showCategory = true, time = false } = Astro.props;
const { title, date, category, breaking, author } = haber.data;
const warn = varsel(title);
const source = kilde(haber);
const forfatter = synligForfatter({ sjanger: haber.data.sjanger, author }, SITE.name, SITE.redaktor);
const harForfatter = forfatter !== SITE.name;
---

<p class="meta">
  {warn && <span class="mark mark-varsel"><Symbol kind="varsel" class={`sym-varsel-${warn.level}`} />{warn.label}</span>}
  {breaking && <span class="mark mark-breaking"><Symbol kind="breaking" />Siste nytt</span>}
  {erForklart(haber) && <span class="mark mark-forklart"><Symbol kind="forklart" />{FORKLART.name}</span>}
  {erAnalyse(haber) && <span class="mark mark-analyse"><Symbol kind="forklart" />{ANALYSE.name}</span>}
  {showCategory && <span class="mark"><Symbol kind={category} />{categoryName(category)}</span>}
  {harForfatter && <span class="mark">Av <a href={`/forfatter/${forfatterSlug(forfatter)}/`}>{forfatter}</a></span>}
  {
    time && (
      <time datetime={date.toISOString()}>{time === 'full' ? `${formatDay(date)} kl. ${formatTime(date)}` : formatTime(date)}</time>
    )
  }
  {source && <span class="mark"><Symbol kind="kilde" />{source}</span>}
</p>
