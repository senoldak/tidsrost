---
// Sayfa sonu yapay zekâ notu (src/lib/kinote.mjs): küçük, sakin tek satır; kutu ve ikon yok.
// Bot sayfaları (canlı tablolar) bot=true ile çağrılır; haberlerde yazar ve sjanger notu belirler.
import { kiNotat } from '../lib/kinote.mjs';

interface Props {
  tittel: string;
  url: string;
  author?: string;
  sjanger?: string;
  bot?: boolean;
}
const { tittel, url, author, sjanger, bot } = Astro.props;
const n = kiNotat({ author, sjanger, tittel, url, bot });
---

<p class="ki-notat" data-ki-notat={n.eier ? 'eier' : 'bot'}>{n.tekst} <a href={n.href}>{n.lenkeTekst}</a></p>
