---
// Sayfa sonu yapay zekâ notu (src/lib/kinote.mjs): küçük, sakin tek satır; kutu ve ikon yok.
// Bot sayfaları (canlı tablolar) bot=true ile çağrılır; haberlerde produksjon (zincir: ki-redigert), yazar ve sjanger
// notu belirler.
import { kiNotat } from '../lib/kinote.mjs';

interface Props {
  tittel: string;
  url: string;
  author?: string;
  sjanger?: string;
  produksjon?: string;
  bot?: boolean;
}
const { tittel, url, author, sjanger, produksjon, bot } = Astro.props;
const n = kiNotat({ author, sjanger, produksjon, tittel, url, bot });
---

<p class="ki-notat" data-ki-notat={n.kjede ? 'kjede' : n.eier ? 'eier' : 'bot'}>{n.tekst} <a href={n.href}>{n.lenkeTekst}</a></p>
