---
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { synligForfatter as synligForfatterAv } from '../../lib/forfatter.mjs';
import { LISENS_JSONLD_URL } from '../../lib/lisens.mjs';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoryRow from '../../components/StoryRow.astro';
import Symbol from '../../components/Symbol.astro';
import { SITE, categoryName, formatDay, formatTime, varsel, gorselVar } from '../../lib/site';
import { ANALYSE, FORKLART, erAnalyse, erForklart, forfatterSlug, getNews, kilde, kildeUrl, type Haber } from '../../lib/news';
import { ORG_ID, SITE_URL, WEBSITE_ID, breadcrumbs, headline } from '../../lib/seo';
import '../../styles/artikkel.css';
import Kildelinje from '../../components/artikkel/Kildelinje.astro';
import Kilder from '../../components/artikkel/Kilder.astro';
import KortOppsummert from '../../components/artikkel/KortOppsummert.astro';
import SlikBleSakenLaget from '../../components/artikkel/SlikBleSakenLaget.astro';
import Verktoylinje from '../../components/artikkel/Verktoylinje.astro';
import FlereSaker from '../../components/artikkel/FlereSaker.astro';
import { normaliserKilder } from '../../lib/kilder.mjs';
import { erEgenTekst, stegFor } from '../../lib/redaksjon.mjs';
import { matchEntities } from '../../lib/entities';
import { indekserbar, ordtelling } from '../../lib/ordtelling.mjs';
import { skjultForSok } from '../../lib/sok-synlighet.mjs';
import { kanRelateres, relaterteSaker } from '../../lib/relaterte';
import Brodsmuler from '../../components/Brodsmuler.astro';
import KiNotat from '../../components/KiNotat.astro';
import { datasiderFor } from '../../lib/datalenker.mjs';
import ForfatterKort, { forfatterBeskrivelse } from '../../components/ForfatterKort.astro';
import { aktiveTemaer, temaerPerSak, temaUrl, type Tema } from '../../lib/temaer';

export async function getStaticPaths() {
  const news = await getNews();
  // İlgili haberler ortak kurum/özel isimlere göre bir kez hesaplanır (src/lib/relaterte.ts).
  const relatert = relaterteSaker(news);
  // Haberin girdiği, sayfası olan temalar (src/lib/tema.mjs): kenar sütununda "Emner" olarak bağlanır.
  const temaer = temaerPerSak(aktiveTemaer(news));
  // «Flere saker»: relaterte først, så de nyeste i samme kategori (tre i alt).
  const flere = (haber: Haber) => {
    const valgt = (relatert.get(haber.id) ?? []).slice(0, 3);
    const brukt = new Set([haber.id, ...valgt.map((h) => h.id)]);
    for (const h of news) {
      if (valgt.length >= 3) break;
      if (brukt.has(h.id) || h.data.category !== haber.data.category || !kanRelateres(h)) continue;
      valgt.push(h);
      brukt.add(h.id);
    }
    return valgt;
  };
  return news.map((haber) => ({
    params: { id: haber.id },
    props: { haber, related: flere(haber), temaer: temaer.get(haber.id) ?? [] },
  }));
}

interface Props {
  haber: Haber;
  related: Haber[];
  temaer: Tema[];
}

const { haber, related, temaer } = Astro.props;
// İlgili veri sayfaları (iç bağlantı): haber KPI, faiz, konut, işsizlik ya da farevarsel anıyorsa (src/lib/datalenker.mjs).
const datasider = datasiderFor(`${haber.data.title} ${haber.data.description ?? ''} ${haber.body ?? ''}`);
const { title, description, date, category, cover: kapak, coverAlt, coverKreditt, author, produksjon, rettelse, oppdatert } = haber.data;
const { Content } = await render(haber);
// OG/JSON-LD görseli her haberde üretilir; büyük WebP kapak yalnızca yeni haberlerde (bkz. gorselVar).
const cover = kapak;
const yeniKapak = cover && gorselVar(date);
// Botun yazılı kapağı (coverKreditt «Illustrasjon: tidsrøst») sayfada gösterilmez: başlık üçüncü kez okunuyordu (30.10.2026).
// Paylaşım görseli (og:image) kapağı kullanmaya devam eder.
const visKapak = cover && coverKreditt !== `Illustrasjon: ${SITE.name}`;
const source = kilde(haber);
const sourceUrl = kildeUrl(haber);
const warn = varsel(title);
const forklart = erForklart(haber);
const analyse = erAnalyse(haber);
const synligForfatter = synligForfatterAv({ sjanger: haber.data.sjanger, author }, SITE.name, SITE.redaktor);
// Kişi adıyla yayımlanan yazıların yazar sayfası vardır (/forfatter/<slug>/).
const forfatterUrl = synligForfatter !== SITE.name ? `/forfatter/${forfatterSlug(synligForfatter)}/` : undefined;

// Kaynaklar adıyla ve bağlantıyla (src/lib/kilder.mjs); eski haberlerde alan yoktur, boş liste döner.
const kilder = normaliserKilder(haber.data.kilder);
const egenTekst = erEgenTekst({ author, sjanger: haber.data.sjanger });
// «Slik ble saken laget»: her tür kendi trinnlerini alır. Zincir yazısı (ki-redigert) som ikke er sjefens egen
// og manuell/ukjent saker beholder den gamle KI-noten (KiNotat).
const slikSak = { produksjon, kilder, nyhetsverdi: haber.data.nyhetsverdi, author, sjanger: haber.data.sjanger };
const visSlik = (stegFor(slikSak)?.length ?? 0) > 0 && (produksjon !== 'ki-redigert' || egenTekst);
const KI_BOT = ['ki-medier', 'ki-kontrollert', 'ki-automatisk', 'ki-assistert', 'ki-redigert'];
const kiBot = !forfatterUrl && KI_BOT.includes(produksjon);
const forfatterNavn = forfatterUrl ? synligForfatter : kiBot ? `${SITE.name} KI-redaksjon` : SITE.name;
const merke = kiBot ? 'KI' : !forfatterUrl && produksjon === 'automatisk' ? 'Automatisk' : undefined;
const ord = ordtelling(haber.body);
const lesetid = ord > 0 ? Math.max(1, Math.round(ord / 200)) : 0;
const kategoriNavn = { slug: category, navn: categoryName(category) };

// OG görseli en az 1200 px genişlikte (Google Discover); kaynak daha darsa kendi genişliği kullanılır.
const ogWidth = cover ? Math.min(1200, cover.width) : 1200;
const ogHeight = cover && ogWidth ? Math.round((ogWidth * cover.height) / cover.width) : 630;
// Kapaksız haberde ortak varsayılan görsel (public/og-default.png, 1200×630).
const ogImage = cover ? (await getImage({ src: cover, width: ogWidth, format: 'jpeg' })).src : '/og-default.png';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const iso = date.toISOString();
// Düzeltme ya da güncelleme tarihi (oppdatert) varsa dateModified odur; yayın tarihinden önce olamaz.
const endret = oppdatert && oppdatert > date ? oppdatert : undefined;
const modifiedIso = (endret ?? date).toISOString();
// Çok kısa haberler bütün arama motorlarına kapalı (noindex, follow). Medya yeniden yazımları ve farevarsel
// derlemeleri yalnız Google'a kapalı (googlebot); ikisi de site haritalarında yok (src/lib/sok-synlighet.mjs).
const noindex = !indekserbar(haber.body);
const googleNoindex = skjultForSok({ produksjon: haber.data.produksjon, id: haber.id, title });
const section = categoryName(category);
const categoryUrl = `${SITE_URL}/kategori/${category}/`;
const sti = [
  { name: 'Forsiden', url: `${SITE_URL}/` },
  { name: section, url: categoryUrl },
  { name: headline(title), url: pageUrl },
];
const entities = matchEntities(`${title} ${description} ${source ?? ''} ${haber.body ?? ''}`);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': analyse ? 'AnalysisNewsArticle' : forklart ? 'ExplanatoryNewsArticle' : 'NewsArticle',
      '@id': `${pageUrl}#article`,
      headline: headline(title),
      description,
      image: [{ '@type': 'ImageObject', url: new URL(ogImage, Astro.site).href, width: ogWidth, height: ogHeight }],
      datePublished: iso,
      dateModified: modifiedIso,
      author: forfatterUrl
        ? [{ '@type': 'Person', name: synligForfatter, jobTitle: 'Journalist', description: forfatterBeskrivelse(synligForfatter), url: `${SITE_URL}${forfatterUrl}` }]
        : { '@id': ORG_ID },
      // Yayıncının tam tanımı (publishingPrinciples dahil) Base.astro'daki Organization düğümünde (src/lib/seo.ts);
      // burada aynı @id ile çelişen ikinci bir tanım yazılmaz, sadece ona bağlanılır.
      publisher: { '@id': ORG_ID },
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      url: pageUrl,
      articleSection: analyse ? [section, ANALYSE.name] : forklart ? [section, FORKLART.name] : section,
      inLanguage: 'nb',
      isAccessibleForFree: true,
      license: LISENS_JSONLD_URL,
      isPartOf: { '@id': WEBSITE_ID },
      ...(entities.length > 0 ? { about: entities } : {}),
    },
    breadcrumbs(sti),
  ],
};
---

<Base title={title} description={description} image={ogImage} imageWidth={ogWidth} imageHeight={ogHeight} imageAlt={coverAlt ?? title} type="article" noindex={noindex} googleNoindex={googleNoindex}>
  <Fragment slot="head">
    <meta property="article:published_time" content={iso} />
    <meta property="article:modified_time" content={modifiedIso} />
    <meta property="article:section" content={section} />
    {forklart && <meta property="article:tag" content={FORKLART.name} />}
    {analyse && <meta property="article:tag" content={ANALYSE.name} />}
    <meta name="author" content={synligForfatter} />
    <script type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  </Fragment>

  <div class="na-fremdrift" aria-hidden="true"><span></span></div>
  <div class="na-brod"><Brodsmuler items={sti} /></div>

  <div class="na-ramme">
    <div class="na-hode">
      <p class="na-kicker">
        {
          warn && (
            <a class="mark mark-varsel" href="/farevarsler/"><Symbol kind="varsel" class={`sym-varsel-${warn.level}`} />{warn.label}</a>
          )
        }
        {forklart && <a href={`/${FORKLART.slug}/`}><Symbol kind="forklart" />{FORKLART.name}</a>}
        {analyse && <a href={`/${ANALYSE.slug}/`}><Symbol kind="forklart" />{ANALYSE.name}</a>}
        <a href={`/kategori/${category}/`}><Symbol kind={category} />{section}</a>
      </p>
      <h1>{title}</h1>
      <p class="na-ingress">{description}</p>

      <div class="na-fortsett" hidden>
        <span>Du har lest deler av denne saken før.</span>
        <button type="button">Fortsett der du slapp →</button>
      </div>

      <div class="na-meta">
        <div class="rad">
          <span>
            Av {forfatterUrl ? <a href={forfatterUrl} rel="author"><strong>{forfatterNavn}</strong></a> : <strong>{forfatterNavn}</strong>}
            {merke && <span class="na-ki">{merke}</span>}
          </span>
          <span><time datetime={iso}>{formatDay(date)} kl. {formatTime(date)}</time></span>
          {endret && <span>Oppdatert <time datetime={modifiedIso}>{formatDay(endret)} kl. {formatTime(endret)}</time></span>}
          {lesetid > 0 && <span>{lesetid} min lesing</span>}
        </div>
        <Kildelinje kilder={kilder} produksjon={produksjon} />
      </div>

      <Verktoylinje url={pageUrl} title={title} />
    </div>

    <div class="na-tekst">
      {
        visKapak && (
          <figure>
            {yeniKapak ? (
              <Image src={cover} alt={coverAlt ?? title} width={1200} loading="eager" fetchpriority="high" decoding="async" />
            ) : (
              <img src={ogImage} alt={coverAlt ?? title} width={ogWidth} height={ogHeight} loading="eager" decoding="async" />
            )}
            {(coverAlt || coverKreditt) && (
              <figcaption>
                {coverAlt}
                {coverKreditt && <span class="kreditt">{coverKreditt}</span>}
              </figcaption>
            )}
          </figure>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        rettelse && (
          <aside class="rettelse">
            <Symbol kind="rettelse" />
            <p>
              <strong>Rettelse{oppdatert ? ` (${formatDay(oppdatert)})` : ''}:</strong> {rettelse}{' '}
              <a href="/rettelser/">Alle rettelser</a>
            </p>
          </aside>
        )
      }

      {analyse && <p class="ikke-rad">Analysen er ikke investeringsråd.</p>}

      {
        datasider.length > 0 && (
          <aside class="tall-lenke" aria-label="Tallene bak saken">
            <span class="tall-lenke-tittel">Tallene bak saken</span>
            {datasider.map((d) => (
              <a href={d.url}>{d.navn}</a>
            ))}
          </aside>
        )
      }

      {forfatterUrl && <ForfatterKort name={synligForfatter} heading="h3" />}

      <Kilder kilder={kilder} produksjon={produksjon} />

      {
        temaer.length > 0 && (
          <p class="na-emner">
            <span class="na-etikett">Emner</span>
            {temaer.map((t) => (
              <a href={temaUrl(t.slug)}>{t.navn}</a>
            ))}
          </p>
        )
      }

      {!visSlik && <KiNotat tittel={title} url={pageUrl} author={author} sjanger={haber.data.sjanger} produksjon={produksjon} />}
    </div>

    <div class="na-rail">
      <div class="na-rail-inn">
        <KortOppsummert whyMatters={haber.data.why_matters} keyPoints={haber.data.key_points} />
        {visSlik && <SlikBleSakenLaget sak={slikSak} tittel={title} url={pageUrl} publisert={date} endret={endret} />}
      </div>
    </div>
  </div>

  <FlereSaker saker={related} kategori={kategoriNavn} />
</Base>
