---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoryRow from '../../components/StoryRow.astro';
import Symbol from '../../components/Symbol.astro';
import { SITE, PRODUKSJON, categoryName, formatDay, formatTime, produksjonMerke, varsel } from '../../lib/site';
import { getNews, kilde, type Haber } from '../../lib/news';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((haber) => ({
    params: { id: haber.id },
    props: { haber, related: news.filter((h) => h !== haber && h.data.category === haber.data.category).slice(0, 3) },
  }));
}

interface Props {
  haber: Haber;
  related: Haber[];
}

const { haber, related } = Astro.props;
const { title, description, date, category, cover, coverAlt, coverKreditt, author, produksjon, rettelse } = haber.data;
const { Content } = await render(haber);
const source = kilde(haber);
const made = produksjonMerke(produksjon);
const warn = varsel(title);

const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpeg' })).src : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const share = encodeURIComponent(pageUrl);
const shareText = encodeURIComponent(title);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: author === SITE.name ? { '@type': 'Organization', name: author } : { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: pageUrl,
  ...(ogImage ? { image: [new URL(ogImage, Astro.site).href] } : {}),
};
---

<Base title={title} description={description} image={ogImage} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <meta property="article:section" content={categoryName(category)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="article">
    <h1>{title}</h1>
    <p class="lead">{description}</p>

    <dl class="margin-info">
      {
        warn && (
          <div>
            <dt>Varsel</dt>
            <dd><span class="mark mark-varsel"><Symbol kind="varsel" class={`sym-varsel-${warn.level}`} />{warn.label}</span></dd>
          </div>
        )
      }
      <div>
        <dt>Tema</dt>
        <dd><a class="mark" href={`/kategori/${category}/`}><Symbol kind={category} />{categoryName(category)}</a></dd>
      </div>
      <div>
        <dt>Publisert</dt>
        <dd><time datetime={date.toISOString()}>{formatDay(date)} kl. {formatTime(date)}</time></dd>
      </div>
      {
        source && (
          <div>
            <dt>Kilde</dt>
            <dd><span class="mark"><Symbol kind="kilde" />{source}</span></dd>
          </div>
        )
      }
      {
        made && (
          <div>
            <dt>Laget</dt>
            <dd><span class="mark"><Symbol kind={made.kind} />{made.label}</span></dd>
          </div>
        )
      }
      <div>
        <dt>Av</dt>
        <dd>{author}</dd>
      </div>
    </dl>

    {
      cover && (
        <figure>
          <Image src={cover} alt={coverAlt ?? title} widths={[760, 1200]} sizes="(max-width: 1080px) 100vw, 920px" loading="eager" />
          {(coverAlt || coverKreditt) && (
            <figcaption>
              {coverAlt}
              {coverKreditt && <span class="kreditt">{coverKreditt}</span>}
            </figcaption>
          )}
        </figure>
      )
    }

    {
      rettelse && (
        <aside class="rettelse">
          <Symbol kind="rettelse" />
          <p><strong>Rettelse:</strong> {rettelse}</p>
        </aside>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      PRODUKSJON[produksjon] && (
        <p class="produksjon">
          {made && <Symbol kind={made.kind} />}
          <span>
            {PRODUKSJON[produksjon]} <a href="/om-oss/#ki">Les mer om hvordan sakene våre lages.</a>
          </span>
        </p>
      )
    }

    <div class="share">
      <span>Del saken:</span>
      <a href={`https://x.com/intent/post?url=${share}&text=${shareText}`} target="_blank" rel="noopener">X</a>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener">Facebook</a>
      <a href={`https://wa.me/?text=${shareText}%20${share}`} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="related">
        <h2 class="band">Mer om {categoryName(category).toLowerCase()}</h2>
        {related.map((h) => (
          <StoryRow haber={h} showCategory={false} />
        ))}
      </section>
    )
  }
</Base>
