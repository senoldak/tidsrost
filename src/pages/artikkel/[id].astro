---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import { SITE, PRODUKSJON, categoryName, formatDate } from '../../lib/site';
import { getNews, type Haber } from '../../lib/news';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((haber) => ({
    params: { id: haber.id },
    props: { haber, related: news.filter((h) => h !== haber && h.data.category === haber.data.category).slice(0, 3) },
  }));
}

interface Props {
  haber: Haber;
  related: Haber[];
}

const { haber, related } = Astro.props;
const { title, description, date, category, cover, coverAlt, author, produksjon, rettelse } = haber.data;
const { Content } = await render(haber);

const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpeg' })).src : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const share = encodeURIComponent(pageUrl);
const shareText = encodeURIComponent(title);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: author === SITE.name ? { '@type': 'Organization', name: author } : { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: pageUrl,
  ...(ogImage ? { image: [new URL(ogImage, Astro.site).href] } : {}),
};
---

<Base title={title} description={description} image={ogImage} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <meta property="article:section" content={categoryName(category)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="article">
    <a class="kicker" href={`/kategori/${category}/`}>{categoryName(category)}</a>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <div class="byline meta">
      <strong>{author}</strong> · <time datetime={date.toISOString()}>{formatDate(date, true)}</time>
    </div>

    {
      cover && (
        <figure>
          <Image src={cover} alt={coverAlt ?? title} widths={[760, 1200]} sizes="(max-width: 800px) 100vw, 760px" loading="eager" />
          {coverAlt && <figcaption>{coverAlt}</figcaption>}
        </figure>
      )
    }

    {
      rettelse && (
        <aside class="rettelse">
          <strong>Rettelse:</strong> {rettelse}
        </aside>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {PRODUKSJON[produksjon] && <p class="produksjon">{PRODUKSJON[produksjon]} <a href="/om-oss/#ki">Les mer om hvordan vi bruker KI og automatikk.</a></p>}

    <div class="share">
      <a href={`https://x.com/intent/post?url=${share}&text=${shareText}`} target="_blank" rel="noopener">Del på X</a>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener">Facebook</a>
      <a href={`https://wa.me/?text=${shareText}%20${share}`} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section">
        <div class="section-title">
          <h2>Relaterte saker</h2>
        </div>
        <div class="grid">
          {related.map((h) => (
            <NewsCard haber={h} />
          ))}
        </div>
      </section>
    )
  }
</Base>
