---
// Yazar sayfası: kişi adıyla yayımlanan yazılar (author ≠ site adı). Biyografi uydurulmaz; sadece yazılar listelenir.
import Base from '../../layouts/Base.astro';
import StoryRow from '../../components/StoryRow.astro';
import { SITE } from '../../lib/site';
import { forfatterSlug, getNews, newsUrl, type Haber } from '../../lib/news';
import { ORG_ID, SITE_URL, WEBSITE_ID, breadcrumbs } from '../../lib/seo';

export async function getStaticPaths() {
  const byAuthor = new Map<string, Haber[]>();
  for (const h of await getNews()) {
    if (h.data.author === SITE.name) continue;
    byAuthor.set(h.data.author, [...(byAuthor.get(h.data.author) ?? []), h]);
  }
  return [...byAuthor].map(([name, items]) => ({ params: { slug: forfatterSlug(name) }, props: { name, items } }));
}

const { name, items } = Astro.props;
const pageUrl = `${SITE_URL}/forfatter/${forfatterSlug(name)}/`;
const description = `${name} er journalist i ${SITE.name} og arbeider med nyhets-, data- og økonomi- og samfunnsjournalistikk basert på offentlige primærkilder.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name,
      description,
      inLanguage: 'nb',
      isPartOf: { '@id': WEBSITE_ID },
      mainEntity: {
        '@type': 'Person',
        '@id': `${pageUrl}#person`,
        name,
        jobTitle: 'Journalist',
        url: pageUrl,
        ...(SITE.epost ? { email: SITE.epost } : {}),
        worksFor: { '@id': ORG_ID },
        knowsAbout: ['Norsk økonomi', 'Offentlig forvaltning', 'Datajournalistikk', 'Samfunn og arbeidsliv', 'Energi og klima'],
      },
      hasPart: items.slice(0, 50).map((h) => ({ '@type': 'NewsArticle', url: new URL(newsUrl(h), SITE_URL).href, headline: h.data.title })),
    },
    breadcrumbs([
      { name: 'Forsiden', url: `${SITE_URL}/` },
      { name, url: pageUrl },
    ]),
  ],
};
---

<Base title={`${name} – Journalist`} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <header class="page-head">
    <h1 class="page-title">{name}</h1>
    <p class="page-intro">
      Journalist i {SITE.name}. Arbeider med forklarende nyhets- og datajournalistikk om norsk økonomi, arbeidsliv,
      velferd, energi og samfunn i tråd med <a href="https://www.presse.no/vaer-varsom-plakaten">Vær Varsom-plakaten</a>.
    </p>
    <p class="meta">
      Journalist i {SITE.name} · {items.length} publiserte {items.length === 1 ? 'sak' : 'saker'}
      {SITE.epost && <> · Kontakt: <a href={`mailto:${SITE.epost}`}>{SITE.epost}</a></>}
    </p>
  </header>
  <section class="day">
    {items.map((h) => <StoryRow haber={h} dato />)}
  </section>
</Base>
