---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---

<Base title="Om oss">
  <article class="article">
    <h1>Om oss</h1>
    <div class="prose">
      <p>
        {SITE.name} er en uavhengig nyhetsside som formidler de viktigste nyhetene fra Norge og verden på en klar og
        lettfattelig måte.
      </p>
      <p>Har du tips eller spørsmål? Ta kontakt med oss via sosiale medier.</p>
    </div>
  </article>
</Base>
