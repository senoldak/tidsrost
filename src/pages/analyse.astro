---
// "Analyse" bölümü: yazı işleri zincirinin analiz yazıları (frontmatter: sjanger: analyse).
import { jsonLdMetni } from '../lib/json-ld.mjs';
import Base from '../layouts/Base.astro';
import StoryRow from '../components/StoryRow.astro';
import Symbol from '../components/Symbol.astro';
import { SITE } from '../lib/site';
import { ANALYSE, erAnalyse, getNews, newsUrl } from '../lib/news';
import { ORG_ID, SITE_URL, WEBSITE_ID, breadcrumbs } from '../lib/seo';

const items = (await getNews()).filter(erAnalyse);
const pageUrl = `${SITE_URL}/${ANALYSE.slug}/`;
const description = `Analyser av økonomi og samfunn, bygget på tall fra offentlige kilder. Analysene er ikke investeringsråd. Fra ${SITE.name}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: `${ANALYSE.name} – hva tallene betyr`,
      description,
      inLanguage: 'nb',
      isPartOf: { '@id': WEBSITE_ID },
      publisher: { '@id': ORG_ID },
      ...(items.length
        ? {
            mainEntity: {
              '@type': 'ItemList',
              itemListElement: items.slice(0, 50).map((h, i) => ({
                '@type': 'ListItem',
                position: i + 1,
                url: new URL(newsUrl(h), SITE_URL).href,
              })),
            },
          }
        : {}),
    },
    breadcrumbs([
      { name: 'Forsiden', url: `${SITE_URL}/` },
      { name: ANALYSE.name, url: pageUrl },
    ]),
  ],
};
---

<Base title={`${ANALYSE.name} – hva tallene betyr`} description={description} noindex={items.length === 0}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <header class="page-head">
    <h1 class="page-title"><Symbol kind="forklart" />{ANALYSE.name}</h1>
    <p class="page-intro">
      Hva tallene betyr. Her vurderer vi utviklingen med utgangspunkt i offentlige kilder, og lenker alltid til
      grunnlaget. Analysen er ikke investeringsråd.
    </p>
    <p class="meta">{items.length} {items.length === 1 ? 'sak' : 'saker'}</p>
  </header>
  {
    items.length > 0 ? (
      <section class="day">
        {items.map((h) => (
          <StoryRow haber={h} dato />
        ))}
      </section>
    ) : (
      <p class="empty">Ingen analyser ennå.</p>
    )
  }
</Base>
