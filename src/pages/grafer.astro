---
import Base from '../layouts/Base.astro';
import Brodsmuler from '../components/Brodsmuler.astro';
import TidsrostChartCard from '../components/kartlar/TidsrostChartCard.astro';
import { TİDSROST_GRAFİKLER } from '../lib/tidsrost-charts-data';
import { SITE } from '../lib/site';
import { SITE_URL } from '../lib/seo';

const baslik = 'Norsk Fakta- og Statistikkatalog — 62 Interaktive Grafer';
const description =
  '62 interaktive grafikkomponenter for norsk økonomi, styringsrente, boligpriser, kraftpriser, arbeidsmarked og Oljefondet fra SSB og Norges Bank.';

const kategorier = [
  'ALLE',
  'MAKROØKONOMI & RENTER',
  'BOLIG & EIENDOM',
  'KRAFT & ENERGI',
  'ARBEIDSLIV & LØNN',
  'OLJEFONDET & BØRS',
  'SAMFUNN & STATISTIKK',
];

const crumbs = [
  { name: 'Forsiden', url: `${SITE_URL}/` },
  { name: 'Grafer', url: `${SITE_URL}/grafer/` },
];

const normaliser = (str: string) =>
  str
    .toLowerCase()
    .replace(/æ/g, 'ae')
    .replace(/ø/g, 'o')
    .replace(/å/g, 'a');
---

<Base title={baslik} description={description}>
  <div class="katalog-kapsayici">
    <Brodsmuler items={crumbs} />

    <header class="sayfa-baslik-alani">
      <div class="ust-etiket">
        <span class="kontur-linje" aria-hidden="true"></span>
        <span>N50 EKVIDISTANSE · ÅPNE DATA & STATISTIKK</span>
      </div>
      <h1>Norsk Fakta- og Statistikkatalog</h1>
      <p class="sayfa-ozet">
        62 interaktive datakomponenter basert på etterrettelige tall fra Statistisk sentralbyrå (SSB), Norges Bank, NVE og Statens pensjonsfond utland.
      </p>
    </header>

    <!-- Filterpanel -->
    <div class="filtre-paneli">
      <div class="kategori-butonlari" role="tablist" aria-label="Kategorifilter">
        {
          kategorier.map((kat, i) => (
            <button
              type="button"
              class={`kategori-sekme ${i === 0 ? 'aktiv' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-kategori={kat}
            >
              {kat}
            </button>
          ))
        }
      </div>

      <div class="arama-kutusu-sarmal">
        <label for="grafik-arama" class="sr-only">Søk i grafer</label>
        <input
          type="search"
          id="grafik-arama"
          placeholder="Søk blant 62 grafer, indikatorer eller kilder..."
          class="arama-girdisi"
          autocomplete="off"
        />
      </div>
    </div>

    <!-- Teller -->
    <div class="sonuc-bilgisi">
      <span>Totalt <strong>{TİDSROST_GRAFİKLER.length}</strong> statistiske indikatorer</span>
      <span id="gorunen-sayac" class="gorunen-adet">62 vises</span>
    </div>

    <!-- 62 Kart i Rutenett -->
    <div class="grafikler-izgara" id="grafikler-izgara">
      {
        TİDSROST_GRAFİKLER.map((grafik) => {
          const soketekst = normaliser(
            `${grafik.baslik} ${grafik.aciklama} ${grafik.metrik} ${grafik.kategori} ${grafik.kaynak} ${grafik.id}`
          );
          return (
            <div
              class="grafik-karti-sarmal"
              data-kategori={grafik.kategori}
              data-tur={grafik.tur}
              data-sok={soketekst}
            >
              <TidsrostChartCard grafik={grafik} />
            </div>
          );
        })
      }
    </div>
  </div>
</Base>

<script>
  const aramaInput = document.getElementById('grafik-arama') as HTMLInputElement | null;
  const kategoriButonlari = document.querySelectorAll<HTMLButtonElement>('.kategori-sekme');
  const kartlar = document.querySelectorAll<HTMLElement>('.grafik-karti-sarmal');
  const gorunenSayac = document.getElementById('gorunen-sayac');

  let aktivKategori = 'ALLE';
  let soketekst = '';

  const normaliser = (str: string) =>
    str
      .toLowerCase()
      .replace(/æ/g, 'ae')
      .replace(/ø/g, 'o')
      .replace(/å/g, 'a');

  function filtrer() {
    let antall = 0;
    kartlar.forEach((kart) => {
      const kat = kart.dataset.kategori ?? '';
      const sok = kart.dataset.sok ?? '';

      const kategoriMatch =
        aktivKategori === 'ALLE' || kat.toUpperCase() === aktivKategori.toUpperCase();
      const sokMatch = !soketekst || sok.includes(soketekst);

      if (kategoriMatch && sokMatch) {
        kart.style.display = '';
        antall++;
      } else {
        kart.style.display = 'none';
      }
    });

    if (gorunenSayac) {
      gorunenSayac.textContent = `${antall} vises`;
    }
  }

  kategoriButonlari.forEach((btn) => {
    btn.addEventListener('click', () => {
      kategoriButonlari.forEach((b) => {
        b.classList.remove('aktiv');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('aktiv');
      btn.setAttribute('aria-selected', 'true');
      aktivKategori = btn.dataset.kategori ?? 'ALLE';
      filtrer();
    });
  });

  if (aramaInput) {
    aramaInput.addEventListener('input', (e) => {
      soketekst = normaliser((e.target as HTMLInputElement).value.trim());
      filtrer();
    });
  }
</script>

<style>
  .katalog-kapsayici {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 4vw, 2.5rem);
    font-family: 'Archivo', -apple-system, sans-serif;
  }

  .sayfa-baslik-alani {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid #dcded8;
  }

  .ust-etiket {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a0643c;
    background: #f7f3ee;
    padding: 0.25rem 0.625rem;
    border-radius: 3px;
    margin-bottom: 0.875rem;
  }

  .kontur-linje {
    width: 12px;
    height: 2px;
    background: #a0643c;
    display: inline-block;
  }

  .sayfa-baslik-alani h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #16191c;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.75rem 0;
  }

  .sayfa-ozet {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: #444a52;
    max-width: 75ch;
    margin: 0;
  }

  .filtre-paneli {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
    background: #f6f7f3;
    padding: 1.25rem;
    border-radius: 4px;
    border: 1px solid #dcded8;
  }

  @media (min-width: 768px) {
    .filtre-paneli {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .kategori-butonlari {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kategori-sekme {
    background: #ffffff;
    border: 1px solid #dcded8;
    color: #444a52;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.375rem 0.75rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
  }

  .kategori-sekme:hover {
    border-color: #1f5f99;
    color: #1f5f99;
  }

  .kategori-sekme.aktiv {
    background: #1f5f99;
    border-color: #1f5f99;
    color: #ffffff;
  }

  .arama-kutusu-sarmal {
    min-width: 280px;
  }

  .arama-girdisi {
    width: 100%;
    padding: 0.45rem 0.75rem;
    font-size: 0.875rem;
    font-family: inherit;
    border: 1px solid #dcded8;
    border-radius: 3px;
    background: #ffffff;
    color: #16191c;
  }

  .arama-girdisi:focus {
    outline: none;
    border-color: #1f5f99;
    box-shadow: 0 0 0 2px rgba(31, 95, 153, 0.15);
  }

  .sonuc-bilgisi {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: #656d77;
    margin-bottom: 1.5rem;
    padding: 0 0.25rem;
  }

  .gorunen-adet {
    font-weight: 600;
    color: #1f5f99;
  }

  .grafikler-izgara {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .grafikler-izgara {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .grafikler-izgara {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .grafik-karti-sarmal {
    display: flex;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
