---
// "Tall og data": veri sayfalarının vitrini. Beş grup, her satırda son değer (src/data/*.json) ve tek cümle; rakamlar veriden.
// Düzen haber satırıyla aynı: değer sütunu + metin gövdesi (DESIGN.md: kart yok, rütbe tek adım yazı boyuyla).
import { jsonLdMetni } from '../lib/json-ld.mjs';
import KiNotat from '../components/KiNotat.astro';
import Base from '../layouts/Base.astro';
import Symbol from '../components/Symbol.astro';
import Brodsmuler from '../components/Brodsmuler.astro';
import { tallTekst } from '../lib/graf.mjs';
import { RENTE, VARSELARKIV, datoTekst, osloIdag, prosent } from '../lib/data';
import { kvartalTekst, maanedTekst } from '../lib/datasider';
import { dagerFraArkiv, dekning, erKomplett, periodeTall } from '../lib/varselstat.mjs';
import { ORG_ID, SITE_URL, WEBSITE_ID, breadcrumbs } from '../lib/seo';
import pris from '../data/prisstigning.json';
import bolig from '../data/boligpriser.json';
import arbeid from '../data/arbeidsledighet.json';
import kpiHist from '../data/kpi-historisk.json';
import snoskredData from '../data/snoskred.json';
import flomData from '../data/flom.json';
import navnData from '../data/navn.json';
import lonnData from '../data/lonn.json';
import kommuneData from '../data/kommuner.json';
import { dagNivaaer } from '../../scripts/data/nve.mjs';
import { omregn } from '../lib/prisomregner.mjs';
import { arbeidsdagerTotalt } from '../lib/helligdager.mjs';

const pageUrl = `${SITE_URL}/tall/`;
const tittel = 'Tall og data';
const seoTittel = 'Tall og data om Norge: priser, boliger og jobb';
const description = 'Oppdaterte tall fra Statistisk sentralbyrå, Norges Bank og Meteorologisk institutt: prisstigning, boligpriser, arbeidsledighet, styringsrenten og farevarsler.';

const landet = (bolig.regioner as { kode: string; endringAar: number | null }[]).find((r) => r.kode === 'TOTAL');
const dk = dekning(VARSELARKIV);
const til = dk.egneTil && dk.egneTil < osloIdag() ? dk.egneTil : osloIdag();
const fraIdeal = new Date(Date.parse(`${til}T00:00:00Z`) - 29 * 86_400_000).toISOString().slice(0, 10);
const fra = dk.egneFra && dk.egneFra > fraIdeal && (!dk.arkivTil || dk.arkivTil < fraIdeal) ? dk.egneFra : fraIdeal;
const dagerTall = Math.round((Date.parse(`${til}T00:00:00Z`) - Date.parse(`${fra}T00:00:00Z`)) / 86_400_000) + 1;
const varsler30 = dagerTall >= 7 && erKomplett(dk, fra, til) ? periodeTall(dagerFraArkiv(VARSELARKIV), fra, til).total.reduce((a, b) => a + b, 0) : null;

const kpiEksFra = String(Number(kpiHist.sisteAar) - 30);
const kpiEks = omregn(kpiHist, 100, kpiEksFra, kpiHist.sisteAar);

const snoDag = snoskredData.regioner[0]?.dager[0]?.dato;
const snoAntall = snoDag ? dagNivaaer(snoskredData, snoDag).length : null;

const flomFylker = new Set([...Object.keys(flomData.flom), ...Object.keys(flomData.jordskred)]).size;

const vanligsteEtternavn = navnData.etternavn[0];
const alleYrker = lonnData.yrker.find((y) => y.kode === '0-9');

const rodeAar = Number(new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Oslo' }).slice(0, 4));

const grupper = [
  { id: 'priser', navn: 'Priser og penger' },
  { id: 'arbeid', navn: 'Arbeid og lønn' },
  { id: 'folk', navn: 'Folk og steder' },
  { id: 'vaer', navn: 'Vær og varsler' },
  { id: 'kalender', navn: 'Kalender' },
];

const kort = [
  { url: '/prisstigning/', navn: 'Prisstigningen nå', verdi: `${tallTekst(pris.tolvMnd)} %`, tekst: `Endring i konsumprisene siste tolv måneder, ${maanedTekst(pris.sisteMaaned)}.`, kilde: 'SSB', gruppe: 'priser' },
  {
    url: '/grafer/',
    navn: 'Grafer og statistikk',
    verdi: '62',
    tekst: '62 interaktive grafikkomponenter for norsk økonomi, styringsrente, kraft, Oljefondet og SSB-statistikk.',
    kilde: 'SSB / Norges Bank',
    gruppe: 'priser',
  },
  {
    url: '/boligpriser/',
    navn: 'Boligprisene nå',
    verdi: typeof landet?.endringAar === 'number' ? `${tallTekst(landet.endringAar)} %` : '–',
    tekst: `Endring i prisene på brukte boliger siste år, ${kvartalTekst(bolig.sisteKvartal)}.`,
    kilde: 'SSB',
    gruppe: 'priser',
  },
  { url: '/arbeidsledighet/', navn: 'Arbeidsledigheten nå', verdi: `${tallTekst(arbeid.prosent)} %`, tekst: `Arbeidsledige i prosent av arbeidsstyrken, ${maanedTekst(arbeid.sisteMaaned)}.`, kilde: 'SSB', gruppe: 'arbeid' },
  {
    url: '/prisomregner/',
    navn: 'Hva er pengene verdt?',
    verdi: typeof kpiEks === 'number' ? `${Math.round(kpiEks).toLocaleString('nb-NO')} kr` : '–',
    tekst: `Hundre kroner fra ${kpiEksFra} regnet om til prisnivået i ${kpiHist.sisteAar}. Regn om beløp mellom alle år siden ${Object.keys(kpiHist.aar)[0]}.`,
    kilde: 'SSB',
    gruppe: 'priser',
  },
  {
    url: '/navn/',
    navn: 'Navnestatistikk',
    verdi: vanligsteEtternavn?.navn ?? '–',
    tekst: vanligsteEtternavn ? `Det vanligste etternavnet i Norge, med ${vanligsteEtternavn.antall.toLocaleString('nb-NO')} personer. Søk i fornavn og etternavn, og se hva barna fikk i ${navnData.sisteAar}.` : 'Søk i fornavn og etternavn.',
    kilde: 'SSB',
    gruppe: 'folk',
  },
  {
    url: '/lonn/',
    navn: 'Lønn etter yrke',
    verdi: alleYrker?.median ? `${alleYrker.median.toLocaleString('nb-NO')} kr` : '–',
    tekst: `Median månedslønn for alle yrker, november ${lonnData.sisteAar}. Søk etter yrke og se tall for kvinner og menn, sektor og utvikling.`,
    kilde: 'SSB',
    gruppe: 'arbeid',
  },
  {
    url: '/kommune/',
    navn: 'Kommunene i tall',
    verdi: kommuneData.kommuner.length.toLocaleString('nb-NO'),
    tekst: `Kommuner i Norge ${kommuneData.sisteAar}, hver med folketall, alder, flytting, areal og inntekt. Søk etter kommune og se sammenligning med fylket og landet.`,
    kilde: 'SSB',
    gruppe: 'folk',
  },
  {
    url: '/rode-dager/',
    navn: 'Røde dager',
    verdi: String(arbeidsdagerTotalt(rodeAar)),
    tekst: `Arbeidsdager i ${rodeAar}. Datoer for helligdagene, inneklemte dager og arbeidsdager per måned.`,
    kilde: 'Lovdata',
    gruppe: 'kalender',
  },
  {
    url: '/snoskredvarsel/',
    navn: 'Snøskredvarsel',
    verdi: snoAntall === null ? '–' : String(snoAntall),
    tekst: `Varslingsregioner med snøskredvarsel fra NVE, ${snoDag ? datoTekst(snoDag) : 'siste varsel'}. Faregrad per region.`,
    kilde: 'NVE',
    gruppe: 'vaer',
  },
  {
    url: '/flomvarsel/',
    navn: 'Flom og jordskred',
    verdi: String(flomFylker),
    tekst: `Fylker med varsel om flom eller jordskred fra NVE, ${datoTekst(flomData.dato)}. Kart og kommuner per fylke.`,
    kilde: 'NVE',
    gruppe: 'vaer',
  },
  { url: '/styringsrenten/', navn: 'Styringsrenten nå', verdi: prosent(RENTE.rente), tekst: RENTE.gjeldendeFra ? `Gjeldende fra ${datoTekst(RENTE.gjeldendeFra)}.` : 'Norges Banks styringsrente.', kilde: 'Norges Bank', gruppe: 'priser' },
  {
    url: '/farevarsler/',
    navn: 'Farevarsler i Norge',
    verdi: varsler30 === null ? '–' : String(varsler30),
    tekst: `Farevarsler på land de siste ${dagerTall} dagene, fylke for fylke, og hvordan årene står seg.`,
    kilde: 'Meteorologisk institutt',
    gruppe: 'vaer',
  },
];

const sti = [
  { name: 'Forsiden', url: `${SITE_URL}/` },
  { name: tittel, url: pageUrl },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: tittel,
      description,
      inLanguage: 'nb',
      isPartOf: { '@id': WEBSITE_ID },
      publisher: { '@id': ORG_ID },
      hasPart: kort.map((k) => ({ '@type': 'WebPage', name: k.navn, url: `${SITE_URL}${k.url}` })),
    },
    breadcrumbs(sti),
  ],
};
---

<Base title={seoTittel} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <Brodsmuler items={sti} />
  <header class="page-head">
    <h1 class="page-title"><Symbol kind="data" />{tittel}</h1>
    <p class="page-intro">
      Tall fra offentlige kilder, hentet automatisk og forklart kort. Hver side viser hvor tallene kommer fra og når de
      sist ble oppdatert.
    </p>
  </header>

  <div class="tall-grupper">
    {
      grupper.map((g) => {
        const rader = kort.filter((k) => k.gruppe === g.id);
        return (
          rader.length > 0 && (
            <section class="tall-gruppe" aria-labelledby={`gruppe-${g.id}`}>
              <h2 class="band" id={`gruppe-${g.id}`}>
                {g.navn}
              </h2>
              <ul class="tall-liste">
                {rader.map((k) => (
                  <li class="tall-rad">
                    <p class="tall-verdi">{k.verdi}</p>
                    <div>
                      <h3>
                        <a href={k.url}>{k.navn}</a>
                      </h3>
                      <p class="tall-tekst">{k.tekst}</p>
                      <span class="tall-kilde">
                        <Symbol kind="kilde" />
                        Kilde: {k.kilde}
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        );
      })
    }
  </div>
  <KiNotat tittel={tittel} url={pageUrl} bot />
</Base>
