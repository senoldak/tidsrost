---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import { CATEGORIES, categoryName, formatDate } from '../lib/site';
import { getNews, newsUrl } from '../lib/news';

const news = await getNews();
const breaking = news.filter((h) => h.data.breaking).slice(0, 5);
const hero = news.find((h) => h.data.featured) ?? news[0];
const rest = news.filter((h) => h !== hero);
const side = rest.slice(0, 4);
const latest = rest.slice(4, 12);
const sections = CATEGORIES.map((c) => ({
  ...c,
  items: news.filter((h) => h.data.category === c.slug && h !== hero).slice(0, 4),
})).filter((s) => s.items.length > 0);
---

<Base>
  {
    breaking.length > 0 && (
      <div class="breaking" role="region" aria-label="Siste nytt">
        <span class="breaking-label">Siste nytt</span>
        <div class="breaking-items">
          {breaking.map((h) => (
            <a href={newsUrl(h)}>{h.data.title}</a>
          ))}
        </div>
      </div>
    )
  }

  {
    hero ? (
      <section class="top">
        <article class="hero">
          <a href={newsUrl(hero)}>
            <div class="thumb">
              {hero.data.cover ? (
                <Image
                  src={hero.data.cover}
                  alt={hero.data.coverAlt ?? hero.data.title}
                  widths={[800, 1200]}
                  sizes="(max-width: 800px) 100vw, 760px"
                  loading="eager"
                />
              ) : (
                <div class="thumb-empty">tidsrøst</div>
              )}
            </div>
            <span class="kicker">{categoryName(hero.data.category)}</span>
            <h2>{hero.data.title}</h2>
          </a>
          <p>{hero.data.description}</p>
          <time class="meta" datetime={hero.data.date.toISOString()}>
            {formatDate(hero.data.date, true)}
          </time>
        </article>

        <div class="side-list">
          {side.map((h) => (
            <article class="side-item">
              <a href={newsUrl(h)}>
                <span class="kicker">{categoryName(h.data.category)}</span>
                <h3>{h.data.title}</h3>
              </a>
              <time class="meta" datetime={h.data.date.toISOString()}>
                {formatDate(h.data.date, true)}
              </time>
            </article>
          ))}
        </div>
      </section>
    ) : (
      <p class="empty">Ingen saker ennå.</p>
    )
  }

  {
    latest.length > 0 && (
      <section class="section">
        <div class="section-title">
          <h2>Siste saker</h2>
        </div>
        <div class="grid">
          {latest.map((h) => (
            <NewsCard haber={h} />
          ))}
        </div>
      </section>
    )
  }

  {
    sections.map((s) => (
      <section class="section">
        <div class="section-title">
          <h2>{s.name}</h2>
          <a href={`/kategori/${s.slug}/`}>Se alle →</a>
        </div>
        <div class="grid">
          {s.items.map((h) => (
            <NewsCard haber={h} showCategory={false} />
          ))}
        </div>
      </section>
    ))
  }
</Base>
