---
import { jsonLdMetni } from '../lib/json-ld.mjs';
import { SITE } from '../lib/site';
import { LISENS_URL } from '../lib/lisens.mjs';
import { metaDescription, organization, website } from '../lib/seo';
import { ANALYSE, FORKLART, erAnalyse, erForklart, getActiveCategories, getNews } from '../lib/news';
import Symbol from '../components/Symbol.astro';
import { aktiveTemaer } from '../lib/temaer';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  type?: 'website' | 'article';
  // 404 ve içeriksiz sayfalar arama sonuçlarına girmez.
  noindex?: boolean;
  // Yalnız Google'a kapalı (googlebot meta etiketi); robots etiketi ve canonical açık kalır.
  googleNoindex?: boolean;
}

const { title, description: desc, image, imageWidth, imageHeight, imageAlt, type = 'website', noindex = false, googleNoindex = false } = Astro.props;
const description = desc?.trim() ? desc.trim() : SITE.description;
const metaDesc = metaDescription(description);
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const siteLd = { '@context': 'https://schema.org', '@graph': [organization, website] };
// Uzun başlıklarda site adı eklenmez (Google ~60 karakterden sonrasını keser); ana sayfa açıklayıcı başlık alır.
const fullTitle = title ? (title.length > 55 ? title : `${title} | ${SITE.name}`) : `${SITE.name} – siste nytt`;
const ogTitle = title ?? fullTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/og-default.png', Astro.site).href;
const ogWidth = imageWidth ?? 1200;
const ogHeight = imageHeight ?? 630;
const ogAlt = imageAlt ?? title ?? SITE.name;
const current = Astro.url.pathname;
const categories = await getActiveCategories();
// "Forklart" menüde sadece yayımlanmış en az bir açıklayıcı yazı varsa görünür.
const alleSaker = await getNews();
const harForklart = alleSaker.some(erForklart);
const harAnalyse = alleSaker.some(erAnalyse);
// "Temaer" menüde sadece sayfası olan en az bir tema varsa görünür (src/lib/tema.mjs).
const harTemaer = aktiveTemaer(alleSaker).length > 0;

// Paftanın kenar bilgisi: derleme günü ve yılın kaçıncı günü olduğu ("Ark 283").
const now = new Date();
const oslo = (opts: Intl.DateTimeFormatOptions) => now.toLocaleDateString(SITE.locale, { ...opts, timeZone: 'Europe/Oslo' });
const weekday = oslo({ weekday: 'long' });
const today = oslo({ day: 'numeric', month: 'long', year: 'numeric' });
const [y, m, d] = now.toLocaleDateString('sv-SE', { timeZone: 'Europe/Oslo' }).split('-').map(Number);
const sheet = Math.round((Date.UTC(y, m - 1, d) - Date.UTC(y, 0, 0)) / 86400000);

// "tidsrøst" içindeki ø harfi su mavisiyle gösterilir.
const [nameHead, nameTail] = SITE.name.split('ø');
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta name="robots" content={robots} />
    {/* Yalnız Google'a kapalı sayfa: diğer arama motorları ve yapay zekâ arama botları (ChatGPT, Perplexity, Bing) görmeye devam eder. */}
    {googleNoindex && !noindex && <meta name="googlebot" content="noindex, follow" />}
    <script is:inline src="/tema.js"></script>
    <meta name="theme-color" content="#fdfdfb" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {SITE.social.x && <meta name="twitter:site" content={`@${SITE.social.x.replace(/\/+$/, '').split('/').pop()}`} />}
    <script type="application/ld+json" set:html={jsonLdMetni(siteLd)} />
    <!-- Cloudflare Web Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "0a03e5183ad74518b8d93554d71a962e"}'></script>
    <!-- End Cloudflare Web Analytics -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#innhold">Hopp til innholdet</a>
    <header class="site-header">
      <div class="mast">
        <img class="mast-terrain" src="/kart.svg" alt="" width="1440" height="200" />
        <div class="container mast-inner">
          <a href="/" class="logo label" aria-label={`${SITE.name}, til forsiden`}>
            {nameTail === undefined ? SITE.name : <>{nameHead}<span class="o">ø</span>{nameTail}</>}
          </a>
          {/* Edisyon tek satır; takip simgeleri altbilgide (30.10.2026: başlık tek bir çizim olsun). */}
          <p class="edition label"><span class="edition-ark">Ark {sheet} · {weekday}</span>{' '}<b>{today}</b></p>
        </div>
      </div>
      <nav class="legend-nav" aria-label="Kategorier">
        <div class="container">
          <a href="/" aria-current={current === '/' ? 'page' : undefined}>Forsiden</a>
          {
            harAnalyse && (
              <a href={`/${ANALYSE.slug}/`} aria-current={current.startsWith(`/${ANALYSE.slug}`) ? 'page' : undefined}>
                <Symbol kind="forklart" />
                {ANALYSE.name}
              </a>
            )
          }
          {
            harForklart && (
              <a href={`/${FORKLART.slug}/`} aria-current={current.startsWith(`/${FORKLART.slug}`) ? 'page' : undefined}>
                <Symbol kind="forklart" />
                {FORKLART.name}
              </a>
            )
          }
          {/* Veri sayfaları: /tall/ vitrini ve altı sayfa; redaksiyon grubunun sonunda, ayraç bundan sonra. */}
          <a
            href="/tall/"
            class="nav-forklart"
            aria-current={['/tall', '/prisstigning', '/boligpriser', '/arbeidsledighet', '/styringsrenten', '/farevarsler', '/grafer'].some((y) => current.startsWith(y)) ? 'page' : undefined}
          >
            <Symbol kind="data" />
            Tall
          </a>
          {
            categories.map((c) => (
              <a href={`/kategori/${c.slug}/`} aria-current={current.startsWith(`/kategori/${c.slug}`) ? 'page' : undefined}>
                <Symbol kind={c.slug} />
                {c.name}
              </a>
            ))
          }
          {
            harTemaer && (
              <a href="/tema/" class="nav-tema" aria-current={current.startsWith('/tema/') ? 'page' : undefined}>
                <Symbol kind="tema" />
                Temaer
              </a>
            )
          }
          <button type="button" class="tema-bryter" aria-pressed="false" title="Bytt mellom lyst og mørkt tema">
            <span class="til-mork">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
              Mørkt
            </span>
            <span class="til-lys">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
              Lyst
            </span>
          </button>
          <a href="/sok/" class="nav-sok" aria-current={current.startsWith('/sok') ? 'page' : undefined}>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            Søk
          </a>
        </div>
      </nav>
    </header>

    <main class="container" id="innhold">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo-sm">
            {nameTail === undefined ? SITE.name : <>{nameHead}<span class="o">ø</span>{nameTail}</>}
          </a>
          <p>
            Uavhengig og ikke-kommersiell nyhetsside: korte nyheter, forklarende saker og oppdaterte data.
          </p>
          <dl class="footer-ansvar">
            {
              SITE.redaktor && (
                <div>
                  <dt>Utgiver og redaktør</dt>
                  <dd><a href="/forfatter/senol-dak/">{SITE.redaktor}</a></dd>
                </div>
              )
            }
            {
              SITE.epost && (
                <div>
                  <dt>Kontakt</dt>
                  <dd><a href={`mailto:${SITE.epost}`}>{SITE.epost}</a></dd>
                </div>
              )
            }
            {
              SITE.utgiver && (
                <div>
                  <dt>Utgiver</dt>
                  <dd>{SITE.utgiver}{SITE.orgnr && `, org.nr. ${SITE.orgnr}`}</dd>
                </div>
              )
            }
          </dl>
          <p class="footer-etikk">
            {SITE.name} bruker <a href="https://www.presse.no/vaer-varsom-plakaten">Vær Varsom-plakaten</a> som rettesnor.
          </p>
        </div>

        <section aria-labelledby="footer-saker">
          <h2 id="footer-saker">Saker</h2>
          <ul>
            {harAnalyse && <li><a href={`/${ANALYSE.slug}/`}>{ANALYSE.name}</a></li>}
            {harForklart && <li><a href={`/${FORKLART.slug}/`}>{FORKLART.name}</a></li>}
            {categories.map((c) => <li><a href={`/kategori/${c.slug}/`}>{c.name}</a></li>)}
            {harTemaer && <li><a href="/tema/">Temaer</a></li>}
            <li><a href="/arkiv/">Arkiv</a></li>
          </ul>
        </section>

        <section aria-labelledby="footer-tall">
          <h2 id="footer-tall">Tall og data</h2>
          <ul>
            <li><a href="/tall/">Alle tall og data</a></li>
            <li><a href="/prisstigning/">Prisstigningen nå</a></li>
            <li><a href="/boligpriser/">Boligprisene nå</a></li>
            <li><a href="/arbeidsledighet/">Arbeidsledigheten nå</a></li>
            <li><a href="/styringsrenten/">Styringsrenten nå</a></li>
            <li><a href="/farevarsler/">Farevarsler i Norge</a></li>
            <li><a href="/grafer/">Grafer og statistikk (62)</a></li>
          </ul>
        </section>

        <section aria-labelledby="footer-om">
          <h2 id="footer-om">Om {SITE.name}</h2>
          <ul>
            <li><a href="/om-oss/">Om oss</a></li>
            <li><a href="/redaksjonelle-prinsipper/">Redaksjonelle prinsipper</a></li>
            <li><a href="/om-oss/#arbeidsmetode">Slik arbeider redaksjonen</a></li>
            <li><a href="/bruk-av-ki/">Bruk av KI</a></li>
            <li><a href="/apenhet/">Slik velger vi nyheter</a></li>
            <li><a href="/rettelser/">Rettelser</a></li>
            <li><a href="/rettelsespolitikk/">Rettelsespolitikk</a></li>
            <li><a href="/klager/">Klager</a></li>
            <li><a href="/standardrapport/">Standardrapport</a></li>
            <li><a href="/personvern/">Personvern</a></li>
            <li><a href="/juridisk/">Juridisk informasjon</a></li>
          </ul>
        </section>
      </div>
      <div class="container footer-bunn">
        <nav aria-label={`Følg ${SITE.name}`}>
          {SITE.social.facebook && <a href={SITE.social.facebook} rel="noopener noreferrer">Facebook</a>}
          {SITE.social.instagram && <a href={SITE.social.instagram} rel="noopener noreferrer">Instagram</a>}
          {SITE.social.linkedin && <a href={SITE.social.linkedin} rel="noopener noreferrer">LinkedIn</a>}
          {SITE.social.telegram && <a href={SITE.social.telegram} rel="noopener noreferrer">Telegram</a>}
          {SITE.social.x && <a href={SITE.social.x} rel="noopener noreferrer">X</a>}
          <a href="/rss.xml">RSS</a>
        </nav>
        <span>
          © {new Date().getFullYear()} {SITE.name}
          {SITE.ikkeKommersiell && ' · Ikke-kommersielt nettsted uten annonser'}
          {' · '}Ark {sheet}
        </span>
      </div>
      <div class="container copyright">
        <span>Innhold: <a href={LISENS_URL} rel="license noopener">CC BY-NC 4.0</a>, fritt til ikke-kommersiell bruk med kildehenvisning til {SITE.name}. Logo og navn er ikke omfattet.</span>
      </div>
    </footer>
  </body>
</html>
