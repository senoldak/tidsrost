---
import { jsonLdMetni } from '../lib/json-ld.mjs';
import { SITE } from '../lib/site';
import { metaDescription, organization, website } from '../lib/seo';
import { FORKLART, erForklart, getActiveCategories, getNews } from '../lib/news';
import Symbol from '../components/Symbol.astro';
import { aktiveTemaer } from '../lib/temaer';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  type?: 'website' | 'article';
  // 404 ve içeriksiz sayfalar arama sonuçlarına girmez.
  noindex?: boolean;
}

const { title, description: desc, image, imageWidth, imageHeight, imageAlt, type = 'website', noindex = false } = Astro.props;
const description = desc?.trim() ? desc.trim() : SITE.description;
const metaDesc = metaDescription(description);
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const siteLd = { '@context': 'https://schema.org', '@graph': [organization, website] };
// Uzun başlıklarda site adı eklenmez (Google ~60 karakterden sonrasını keser); ana sayfa açıklayıcı başlık alır.
const fullTitle = title ? (title.length > 55 ? title : `${title} | ${SITE.name}`) : `${SITE.name} – siste nytt fra Norge og verden`;
const ogTitle = title ?? fullTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/og-default.png', Astro.site).href;
const ogWidth = imageWidth ?? 1200;
const ogHeight = imageHeight ?? 630;
const ogAlt = imageAlt ?? title ?? SITE.name;
const current = Astro.url.pathname;
const categories = await getActiveCategories();
// "Forklart" menüde sadece yayımlanmış en az bir açıklayıcı yazı varsa görünür.
const alleSaker = await getNews();
const harForklart = alleSaker.some(erForklart);
// "Temaer" menüde sadece sayfası olan en az bir tema varsa görünür (src/lib/tema.mjs).
const harTemaer = aktiveTemaer(alleSaker).length > 0;

// Paftanın kenar bilgisi: derleme günü ve yılın kaçıncı günü olduğu ("Ark 283").
const now = new Date();
const oslo = (opts: Intl.DateTimeFormatOptions) => now.toLocaleDateString(SITE.locale, { ...opts, timeZone: 'Europe/Oslo' });
const weekday = oslo({ weekday: 'long' });
const today = oslo({ day: 'numeric', month: 'long', year: 'numeric' });
const [y, m, d] = now.toLocaleDateString('sv-SE', { timeZone: 'Europe/Oslo' }).split('-').map(Number);
const sheet = Math.round((Date.UTC(y, m - 1, d) - Date.UTC(y, 0, 0)) / 86400000);

// "tidsrøst" içindeki ø harfi su mavisiyle gösterilir.
const [nameHead, nameTail] = SITE.name.split('ø');
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#fdfdfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171612" media="(prefers-color-scheme: dark)" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {SITE.social.x && <meta name="twitter:site" content={`@${SITE.social.x.replace(/\/+$/, '').split('/').pop()}`} />}
    <script type="application/ld+json" set:html={jsonLdMetni(siteLd)} />
    <!-- Cloudflare Web Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "0a03e5183ad74518b8d93554d71a962e"}'></script>
    <!-- End Cloudflare Web Analytics -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#innhold">Hopp til innholdet</a>
    <header class="site-header">
      <div class="sheet-margin">
        <div class="container">
          {/* Haberlerin bir kısmı resmi kaynaklardan, bir kısmı birden fazla medyada doğrulanmış olaylardan (ki-medier); medya adı yazılmaz. */}
          <span class="sources"><Symbol kind="kilde" />Kilder: offentlige etater · hendelser bekreftet av flere medier</span>
          <span>{SITE.description}</span>
          <nav aria-label="Følg oss">
            {SITE.social.x && <a href={SITE.social.x} rel="noopener noreferrer" target="_blank" aria-label="X (åpnes i ny fane)">X</a>}
            {SITE.social.facebook && <a href={SITE.social.facebook} rel="noopener noreferrer" target="_blank" aria-label="Facebook (åpnes i ny fane)">Facebook</a>}
            {SITE.social.telegram && <a href={SITE.social.telegram} rel="noopener noreferrer" target="_blank" aria-label="Telegram (åpnes i ny fane)">Telegram</a>}
            <a href="/rss.xml">RSS</a>
          </nav>
        </div>
      </div>
      <div class="mast">
        <img class="mast-terrain" src="/kart.svg" alt="" width="1440" height="200" />
        <div class="container mast-inner">
          <a href="/" class="logo label" aria-label={`${SITE.name}, til forsiden`}>
            {nameTail === undefined ? SITE.name : <>{nameHead}<span class="o">ø</span>{nameTail}</>}
          </a>
          <p class="edition label">Ark {sheet} · {weekday}<b>{today}</b></p>
        </div>
      </div>
      <nav class="legend-nav" aria-label="Kategorier">
        <div class="container">
          <a href="/" aria-current={current === '/' ? 'page' : undefined}>Forsiden</a>
          {
            harForklart && (
              <a href={`/${FORKLART.slug}/`} class="nav-forklart" aria-current={current.startsWith(`/${FORKLART.slug}`) ? 'page' : undefined}>
                <Symbol kind="forklart" />
                {FORKLART.name}
              </a>
            )
          }
          {
            categories.map((c) => (
              <a href={`/kategori/${c.slug}/`} aria-current={current.startsWith(`/kategori/${c.slug}`) ? 'page' : undefined}>
                <Symbol kind={c.slug} />
                {c.name}
              </a>
            ))
          }
          {
            harTemaer && (
              <a href="/tema/" class="nav-tema" aria-current={current.startsWith('/tema/') ? 'page' : undefined}>
                <Symbol kind="tema" />
                Temaer
              </a>
            )
          }
          <a href="/sok/" class="nav-sok" aria-current={current.startsWith('/sok') ? 'page' : undefined}>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            Søk
          </a>
        </div>
      </nav>
    </header>

    <main class="container" id="innhold">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo-sm">
            {nameTail === undefined ? SITE.name : <>{nameHead}<span class="o">ø</span>{nameTail}</>}
          </a>
          <p>
            Uavhengig norsk nyhetsside som formidler dybdejournalistikk, dataanalyse og løpende
            nyheter fra Norge og verden.
          </p>
          <dl class="footer-ansvar">
            {
              SITE.redaktor && (
                <div>
                  <dt>Ansvarlig redaktør og journalist</dt>
                  <dd><a href="/forfatter/senol-dak/">{SITE.redaktor}</a></dd>
                </div>
              )
            }
            {
              SITE.epost && (
                <div>
                  <dt>Kontakt</dt>
                  <dd><a href={`mailto:${SITE.epost}`}>{SITE.epost}</a></dd>
                </div>
              )
            }
            {
              SITE.utgiver && (
                <div>
                  <dt>Utgiver</dt>
                  <dd>{SITE.utgiver}{SITE.orgnr && `, org.nr. ${SITE.orgnr}`}</dd>
                </div>
              )
            }
          </dl>
          <p class="footer-etikk">
            Redaksjonen arbeider etter <a href="https://www.presse.no/vaer-varsom-plakaten">Vær Varsom-plakaten</a> og{' '}
            <a href="https://www.redaktor.no/ressurser/etiske-og-juridiske-rammeverk/redaktorplakaten">Redaktørplakaten</a>{' '}
            for god presseskikk.
          </p>
        </div>

        <section aria-labelledby="footer-seksjoner">
          <h2 id="footer-seksjoner">Seksjoner og innhold</h2>
          <ul>
            {
              harForklart && (
                <li>
                  <a href={`/${FORKLART.slug}/`}>
                    <Symbol kind="forklart" />
                    <strong>{FORKLART.name} – dybde og data</strong>
                  </a>
                </li>
              )
            }
            {
              categories.map((c) => (
                <li>
                  <a href={`/kategori/${c.slug}/`}>
                    <Symbol kind={c.slug} />
                    {c.name}
                  </a>
                </li>
              ))
            }
            <li><a href="/styringsrenten/"><Symbol kind="data" />Styringsrenten nå</a></li>
            <li><a href="/farevarsler/"><Symbol kind="varsel" class="sym-varsel-gult" />Farevarsler i dag</a></li>
            {harTemaer && <li><a href="/tema/"><Symbol kind="tema" />Alle temaer</a></li>}
          </ul>
        </section>

        <section aria-labelledby="footer-apenhet">
          <h2 id="footer-apenhet">Åpenhet og informasjon</h2>
          <ul>
            <li><a href="/om-oss/">Om {SITE.name}</a></li>
            <li><a href="/redaksjonelle-prinsipper/">Redaksjonelle prinsipper</a></li>
            <li><a href="/om-oss/#arbeidsmetode">Slik arbeider redaksjonen</a></li>
            <li><a href="/om-oss/#ki">Bruk av KI i {SITE.name}-artikler</a></li>
            <li><a href="/apenhet/">Åpenhet: slik velger vi nyheter</a></li>
            <li><a href="/arkiv/">Arkiv</a></li>
            <li><a href="/redaksjonelle-prinsipper/#rettelser">Rettelser og klager (PFU)</a></li>
            {SITE.redaktor && <li><a href="/forfatter/senol-dak/">Redaksjonen: {SITE.redaktor}</a></li>}
            <li><a href="/personvern/">Personvern og informasjonskapsler</a></li>
            {SITE.social.telegram && <li><a href={SITE.social.telegram} rel="noopener noreferrer">Telegram-kanalen</a></li>}
            <li><a href="/rss.xml">RSS-strøm</a></li>
          </ul>
        </section>
      </div>
      <div class="container copyright">
        <span>
          © {new Date().getFullYear()} {SITE.name}
          {SITE.redaktor && ` · Ansvarlig redaktør: ${SITE.redaktor}`}
          {SITE.ikkeKommersiell && ' · Ikke-kommersielt nettsted uten annonser'}
        </span>
        <span>Ark {sheet} · {today}</span>
      </div>
    </footer>
  </body>
</html>
