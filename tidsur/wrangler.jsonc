{
  // tidsur: haber botunu zamanında başlatan Worker. Sitenin Worker'ından (../wrangler.jsonc) ayrıdır.
  // Yükleme: cd tidsur && npx wrangler deploy   (GITHUB_TOKEN, Cloudflare'de Secret olarak durur)
  "name": "tidsrost-tidsur",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Alan adı yok; bu Worker dışarıdan çağrılmaz, sadece zamanlayıcıyla çalışır.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // UTC; 10 dakikada bir. Haber botu kendi dakikasında başlar (worker.js), Telegram kuyruğu her çağrıda 1 haber gönderir.
    "crons": ["*/10 * * * *"]
  },
  "observability": { "enabled": true },
  // Telegram kuyruğu (telegram.js). TELEGRAM_BOT_TOKEN secret olarak durur: npx wrangler secret put TELEGRAM_BOT_TOKEN
  "vars": { "SITE": "https://tidsrost.com", "TELEGRAM_HEDEFLER": "@tidsrost", "TELEGRAM_ONEK": "" },
  "kv_namespaces": [{ "binding": "TELEGRAM_KV", "id": "46047695f7ee4165b4d8af20719381ef" }]
}
