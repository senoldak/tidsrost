{
  // tidsur: haber botunu zamanında başlatan Worker. Sitenin Worker'ından (../wrangler.jsonc) ayrıdır.
  // Yükleme: cd tidsur && npx wrangler deploy   (GITHUB_TOKEN, Cloudflare'de Secret olarak durur)
  "name": "tidsrost-tidsur",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Alan adı yok; bu Worker dışarıdan çağrılmaz, sadece zamanlayıcıyla çalışır.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // UTC; her saat başı. Worker sadece Oslo saatiyle çift saatlerde botu başlatır (worker.js).
    "crons": ["0 * * * *"]
  },
  "observability": { "enabled": true }
}
