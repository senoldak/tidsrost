{
  // Cloudflare ayarı: statik site (dist/) + küçük Worker (yalnız POST /api/nyttig, "Var saken nyttig?" sayacı).
  "name": "tidsrost",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "tidsrost.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Yalnız /api/* Worker'dan geçer; sayfalar eskisi gibi doğrudan statik sunulur.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Anonim günlük sayaç: gün + sak + ja/nei. IP ya da okur bilgisi saklanmaz.
  "d1_databases": [
    { "binding": "DB", "database_name": "tidsrost-nyttig", "database_id": "74ef0555-fff4-46a3-8443-159661df2a58" }
  ]
}
