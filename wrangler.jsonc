{
  // Cloudflare ayarı: statik site (dist/) ve ukesbrev Worker'ı (worker/index.ts) aynı Worker'da.
  // Sayfalar statik sunulur; yalnız /api/* Worker'a gider (run_worker_first).
  "name": "tidsrost",
  "main": "worker/index.ts",
  // Günlük bülten görevini mecmua-saat Worker'ı tetikler (POST /api/bulten/gorev, GOREV_ANAHTARI); bu Worker'ın cron'u yok
  // çünkü Cloudflare ücretsiz planında hesap başına 5 cron sınırı var. Boş liste, eski cron'u Cloudflare'den siler.
  "triggers": { "crons": [] },
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "tidsrost.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Ukesbrev abonneliste (D1). Şema: migrations/0001_bulten.sql. Uzak uygulama ana oturumda yapılır.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidsrost-bulten",
      "database_id": "8b359ffe-8787-4cc8-b641-431a2e2a2597",
      "migrations_dir": "migrations"
    }
  ],
  // Gönderen adı görünür; adres ASCII kalır. RESEND_API_KEY bir Worker secret'ıdır (wrangler secret put), buraya yazılmaz.
  "vars": {
    "BULTEN_GONDEREN": "tidsrøst <nyhetsbrev@tidsrost.com>"
  }
}
